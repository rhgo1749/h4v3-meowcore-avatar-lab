# Meowcore Avatar Runtime configuration (PR-001 contract)
#
# AVATAR_BIND        process listen bind for bare `node` runs (default
#                    loopback-only). In the compose path this value is
#                    intentionally overridden to 0.0.0.0 inside the
#                    container (the published port must reach it); host
#                    exposure is governed by AVATAR_HOST_BIND.
# AVATAR_HOST_BIND   compose HOST publish bind (default loopback-only).
#                    0.0.0.0 is the explicit opt-in for external exposure.
# AVATAR_PORT        service port; same value on the host publish and the
#                    container listen (compose) or the bare process bind.
AVATAR_BIND=127.0.0.1
AVATAR_HOST_BIND=127.0.0.1
AVATAR_PORT=8930
